import link.*
import direcciones.*
import objetos.*
import enemigos.*
import mapa.*
import partida.*

describe "group of tests for link" {
    method initialize() {
        game.clear()
        game.height(15)
        game.width(20)
        link.reiniciar()
        link.position(game.at(0, 1))
    }

    test "link mover arriba" {
        link.mover(arriba)
        assert.equals(game.at(0, 2), link.position())
    }

    test "link mover abajo" {
        link.mover(abajo)
        assert.equals(game.at(0, 0), link.position())
    }

    test "link mover derecha" {
        link.mover(derecha)
        assert.equals(game.at(1, 1), link.position())
    }

    test "link mover izquierda desde (1,1)" {
        link.position(game.at(1, 1))
        link.mover(izquierda)
        assert.equals(game.at(0, 1), link.position())
    }
}

describe "link cambia de imagen al moverse" {
    method initialize() {
        game.clear()
        game.height(15)
        game.width(20)
        link.reiniciar()
        link.position(game.at(1, 1))
    }

    test "link mover arriba" {
        link.mover(arriba)
        assert.equals("link-normal-arriba.png", link.image())
    }

    test "link mover abajo" {
        link.mover(abajo)
        assert.equals("link-normal-abajo.png", link.image())
    }

    test "link mover derecha" {
        link.mover(derecha)
        assert.equals("link-normal-derecha.png", link.image())
    }

    test "link mover izquierda" {
        link.mover(izquierda)
        assert.equals("link-normal-izquierda.png", link.image())
    }
}

describe "link cambia de imagen pero no se mueve fuera del tablero" {
    method initialize() {
        game.clear()
        game.height(15)
        game.width(20)
        link.reiniciar()
        link.position(game.at(0, 0))
    }

    test "link mover abajo en el borde lanza excepcion" {
        assert.throwsException({ link.mover(abajo) })
        assert.equals("link-normal-abajo.png", link.image())
        assert.equals(game.at(0, 0), link.position())
    }

    test "link mover izquierda en el borde lanza excepcion" {
        assert.throwsException({ link.mover(izquierda) })
        assert.equals("link-normal-izquierda.png", link.image())
        assert.equals(game.at(0, 0), link.position())
    }
}

describe "tests de la logica de ataque y arma" {
    method initialize() {
        game.clear()
        game.height(15)
        game.width(20)
        link.reiniciar()
    }

    test "link cambia su estado a ataque al usar la espada" {
        link.usarArma()
        assert.equals(ataque, link.estado())
    }

    test "la posicion objetivo del ataque se calcula bien segun hacia donde mira Link" {
        link.position(game.at(5, 5))

        link.direccionActual(arriba)
        assert.equals(game.at(5, 6), link.direccionActual().posicionAlLado(link.position()))

        link.direccionActual(derecha)
        assert.equals(game.at(6, 5), link.direccionActual().posicionAlLado(link.position()))

        link.direccionActual(abajo)
        assert.equals(game.at(5, 4), link.direccionActual().posicionAlLado(link.position()))

        link.direccionActual(izquierda)
        assert.equals(game.at(4, 5), link.direccionActual().posicionAlLado(link.position()))
    }

    test "link no puede moverse si ya esta en estado de ataque" {
        const posicion = game.at(5, 5)
        link.position(posicion)
        link.estado(ataque)
        link.mover(derecha)

        assert.equals(posicion, link.position())
    }

    test "link equipa el arco y cambia su imagen al disparar" {
        link.position(game.at(5, 5))
        link.direccionActual(derecha)
        link.equipar(arco)

        assert.equals("link-arco-normal-derecha.png", link.image())

        link.usarArma()

        assert.equals("link-arco-tensando-derecha.png", link.image())
        assert.equals(arcoTensando, link.estado())
    }
}

describe "tests de interactividad de objetos y enemigos" {
    method initialize() {
        game.clear()
        game.height(15)
        game.width(20)
        link.reiniciar()
    }

    test "una vasija recien creada esta sana y bloquea el paso" {
        const vasija = new Vasija(position = game.at(4, 3))
        assert.equals("vasija-sana.png", vasija.image())
        assert.notThat(vasija.esAtravesable())
    }

    test "al recibir daño la vasija se rompe y permite el paso" {
        const vasija = new Vasija(position = game.at(4, 3))
        vasija.recibirAtaque(1)
        assert.equals("vasija-rota.png", vasija.image())
        assert.that(vasija.esAtravesable())
    }

    test "el soldado esquiva una pared para acercarse a Link" {
        link.position(game.at(5, 5))
        game.addVisual(new Pared(position = game.at(5, 4)))
        const soldado = new Soldado(position = game.at(5, 3))

        soldado.moverse()
        assert.notEquals(game.at(5, 4), soldado.position())
        assert.notEquals(game.at(5, 3), soldado.position())
    }

    test "el murcielago se activa al acercarse Link y muere" {
        link.position(game.at(1, 1))
        const murcielago = new Murcielago(position = game.at(15, 10))
        game.addVisual(murcielago)

        murcielago.moverse()
        assert.equals("murcielago-standby.png", murcielago.image())
        assert.equals(game.at(15, 10), murcielago.position())

        link.position(game.at(13, 10))
        murcielago.moverse()
        assert.equals("murcielago-aleteo-1.png", murcielago.image())

        murcielago.recibirAtaque(1)
        assert.equals("murcielago-derrotado.png", murcielago.image())
        assert.that(murcielago.esAtravesable())
    }

    test "link abre puerta con candado" {
        link.position(game.at(18, 11))
        link.direccionActual(derecha)
        link.agarrarLlave()
        const puerta = new PuertaConCandado(position = game.at(19, 11), orientacion = derecha)
        game.addVisual(puerta)

        link.interactuar()

        assert.equals("puerta-abierta-derecha.png", puerta.image())
        assert.that(puerta.esAtravesable())
        assert.notThat(link.tieneLlave())
        assert.equals(game.at(18, 11), link.position())
    }

    test "link abre un cofre" {
        link.position(game.at(5, 5))
        link.direccionActual(arriba)
        const cofre = new Cofre(position = game.at(5, 6), recompensa = new Llave())
        game.addVisual(cofre)

        link.interactuar()

        assert.that(cofre.abierto())
        assert.equals("cofre-abierto.png", cofre.image())
        assert.that(cofre.esAtravesable())
    }

    test "el arquero dispara si esta alineado sin paredes" {
        link.position(game.at(10, 5))
        const arquero = new Arquero(position = game.at(5, 5))
        game.addVisual(arquero)

        assert.that(arquero.puedeAtacar())

        game.addVisual(new Pared(position = game.at(7, 5)))
        assert.notThat(arquero.puedeAtacar())
    }

    test "la bala de canion hace 2 de danio y explota" {
        link.position(game.at(6, 5))
        game.addVisual(link)
        const bala = new BalaDeCanion(position = game.at(6, 5), direccion = derecha)

        bala.lanzar()

        assert.equals(1, link.corazones())
        assert.equals("bala-explosion.png", bala.image())
    }

    test "el canionero inicia con canion y 3 de vida" {
        const canionero = new Canionero(position = game.at(8, 8))
        assert.equals(canion, canionero.armaEquipada())
        assert.equals(3, canionero.vida())
    }

}

describe "tests del jefe y sus ataques" {
    method initialize() {
        spawner.detenerEnemigos()
        game.clear()
        game.height(15)
        game.width(20)
        link.reiniciar()
    }

    test "el jefe no se activa si Link esta fuera de rango" {
        link.position(game.at(9, 1))
        const jefe = new Jefe(position = game.at(9, 10))
        game.addVisual(link)
        game.addVisual(jefe)

        jefe.moverse()

        assert.equals(game.at(9, 10), jefe.position())
        assert.equals("jefe-normal.png", jefe.image())
    }

    test "el jefe se prepara para lanzar tridente cuando Link esta alineado en rango" {
        link.position(game.at(9, 5))
        const jefe = new Jefe(position = game.at(9, 10))
        game.addVisual(link)
        game.addVisual(jefe)

        jefe.moverse()

        assert.equals("jefe-tridente.png", jefe.image())
    }

    test "el jefe usa sprite de espalda cuando apunta hacia arriba" {
        link.position(game.at(9, 10))
        const jefe = new Jefe(position = game.at(9, 5))
        game.addVisual(link)
        game.addVisual(jefe)

        jefe.moverse()

        assert.equals("jefe-tridente-espalda.png", jefe.image())
    }

    test "el jefe inicia el ataque de fuego cuando Link esta cerca" {
        link.position(game.at(9, 8))
        const jefe = new Jefe(position = game.at(9, 10))
        game.addVisual(link)
        game.addVisual(jefe)

        jefe.moverse()

        assert.equals("jefe-ataque-area-1.png", jefe.image())
    }

    test "el jefe entra en regeneracion a mitad de vida y se vuelve invulnerable" {
        const jefe = new Jefe(position = game.at(9, 10))
        game.addVisual(jefe)

        jefe.recibirAtaque(5)
        assert.equals("jefe-regeneracion.png", jefe.image())

        jefe.recibirAtaque(10)
        assert.notThat(jefe.estaVencido())
        assert.equals("jefe-regeneracion.png", jefe.image())
    }

    test "el tridente gira al avanzar y hace 2 de danio al impactar" {
        link.position(game.at(8, 5))
        game.addVisual(link)
        const tridente = new TridenteArrojado(position = game.at(5, 5), direccion = derecha)

        assert.equals("tridente-arriba.png", tridente.image())

        tridente.lanzar()
        tridente.avanzar()
        assert.equals("tridente-derecha.png", tridente.image())

        tridente.avanzar()
        assert.equals("tridente-abajo.png", tridente.image())

        tridente.avanzar()
        assert.equals(1, link.corazones())
    }

    test "la oleada de fuego dania a Link si esta en el area afectada" {
        link.position(game.at(9, 9))
        game.addVisual(link)
        const oleada = new OleadaDeFuego(
            posiciones = [game.at(9, 9), game.at(9, 11)],
            objetivo = link
        )

        oleada.iniciar()

        assert.equals(2, link.corazones())
    }
}

describe "tests de items, bombas y vida de link" {
    method initialize() {
        spawner.detenerEnemigos()
        game.clear()
        game.height(15)
        game.width(20)
        link.reiniciar()
    }

    test "una pared agrietada ignora ataques comunes pero se abre con una explosion" {
        const pared = new ParedAgrietada(position = game.at(5, 6))
        const bomba = new BombaActiva(position = game.at(5, 5))
        game.addVisual(pared)
        game.addVisual(bomba)

        pared.recibirAtaque(1)
        assert.notThat(pared.esAtravesable())

        bomba.explotar()
        assert.that(pared.esAtravesable())
        assert.equals("puerta-abierta-arriba.png", pared.image())
    }

    test "link agarra y coloca una bomba consumiendola del inventario" {
        const bomba = new Bomba(position = game.at(5, 5))
        game.addVisual(bomba)
        link.position(game.at(4, 5))

        link.mover(derecha)
        assert.equals(1, link.bombas())

        link.seleccionarBomba()
        link.usarItemSeleccionado()
        assert.equals(0, link.bombas())
    }

    test "la pocion vuelve invulnerable a Link frente a ataques" {
        link.agarrarPocion()
        link.seleccionarPocion()
        link.usarItemSeleccionado()

        assert.equals(0, link.pociones())
        assert.that(link.invulnerable())

        link.recibirAtaque(2)
        assert.equals(3, link.corazones())
    }

    test "link no supera el maximo de 5 corazones y queda invulnerable tras recibir danio" {
        link.curar(10)
        assert.equals(5, link.corazones())

        link.recibirAtaque(1)
        assert.equals(4, link.corazones())
        assert.that(link.invulnerable())

        link.recibirAtaque(2)
        assert.equals(4, link.corazones())
    }

    test "el arco consume flechas, no dispara sin flechas y se recarga con refill" {
        link.position(game.at(5, 5))
        link.equipar(arco)
        link.usarArma()
        assert.equals(9, link.flechas())

        (1 .. 9).forEach({ _ => link.consumirFlecha() })
        assert.notThat(link.puedeDispararArco())

        link.reiniciar()
        (1 .. 10).forEach({ _ => link.consumirFlecha() })
        link.equipar(arco)
        link.usarArma()
        assert.equals(arcoNormal, link.estado())

        const refill = new RefillFlechas(position = game.at(6, 5))
        game.addVisual(refill)
        link.position(game.at(5, 5))
        link.mover(derecha)
        assert.equals(5, link.flechas())
    }
}

describe "tests de puertas y puntaje" {
    method initialize() {
        spawner.detenerEnemigos()
        game.clear()
        game.height(15)
        game.width(20)
        link.reiniciar()
    }

    test "abrir puerta con candado sin llave lanza excepcion" {
        link.position(game.at(18, 11))
        link.direccionActual(derecha)
        const puerta = new PuertaConCandado(position = game.at(19, 11), orientacion = derecha)
        game.addVisual(puerta)

        assert.throwsException({ link.interactuar() })
        assert.notThat(puerta.esAtravesable())
    }

    test "la puerta por enemigos se abre al derrotar a todos los enemigos de la sala" {
        const puerta = new PuertaPorEnemigos(position = game.at(19, 6), orientacion = derecha)
        const soldado = fabricanteSoldado.crear(game.at(10, 6))
        game.addVisual(puerta)
        game.addVisual(soldado)

        assert.notThat(puerta.esAtravesable())

        soldado.recibirAtaque(2)

        assert.that(puerta.esAtravesable())
        assert.equals("puerta-abierta-derecha.png", puerta.image())
    }

    test "el marcador suma puntos por enemigos vencidos y salas completadas" {
        const puntajeInicial = marcador.puntaje()
        const soldado = fabricanteSoldado.crear(game.at(10, 6))
        game.addVisual(soldado)

        soldado.recibirAtaque(2)
        marcador.completarSala()

        assert.equals(puntajeInicial + 300, marcador.puntaje())
    }
}